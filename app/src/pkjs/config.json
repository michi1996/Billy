[
    {
        "type": "heading",
        "defaultValue": "Buddy",
        "size": 1
    },
    {
        "type": "section",
        "items": [
            {
                "type": "heading",
                "defaultValue": "Server"
            },
            {
                "type": "text",
                "defaultValue": "Buddy sends your prompts to your own llama-server (OpenAI-compatible API) behind Cloudflare Access. The values below are stored only in the Pebble phone app and are never sent to the watch."
            },
            {
                "type": "input",
                "id": "LLM_BASE_URL",
                "messageKey": "LLM_BASE_URL",
                "label": "Server URL",
                "description": "Base URL without a path, e.g. https://llm.example.ch. Buddy appends /v1/chat/completions.",
                "defaultValue": "",
                "attributes": {
                    "type": "url",
                    "placeholder": "https://llm.example.ch",
                    "autocapitalize": "off",
                    "autocorrect": "off"
                }
            },
            {
                "type": "input",
                "id": "CF_ACCESS_CLIENT_ID",
                "messageKey": "CF_ACCESS_CLIENT_ID",
                "label": "Cloudflare Access Client ID",
                "description": "From the Access service token. Sent as CF-Access-Client-Id header.",
                "defaultValue": "",
                "attributes": {
                    "type": "password",
                    "autocomplete": "off",
                    "autocapitalize": "off",
                    "autocorrect": "off"
                }
            },
            {
                "type": "input",
                "id": "CF_ACCESS_CLIENT_SECRET",
                "messageKey": "CF_ACCESS_CLIENT_SECRET",
                "label": "Cloudflare Access Client Secret",
                "description": "From the Access service token. Sent as CF-Access-Client-Secret header.",
                "defaultValue": "",
                "attributes": {
                    "type": "password",
                    "autocomplete": "off",
                    "autocapitalize": "off",
                    "autocorrect": "off"
                }
            },
            {
                "type": "input",
                "id": "LLM_MODEL",
                "messageKey": "LLM_MODEL",
                "label": "Model",
                "description": "Sent as the model field. llama-server usually ignores it.",
                "defaultValue": "qwen2.5-14b-instruct",
                "attributes": {
                    "autocapitalize": "off",
                    "autocorrect": "off"
                }
            },
            {
                "type": "slider",
                "id": "LLM_TIMEOUT_SECONDS",
                "messageKey": "LLM_TIMEOUT_SECONDS",
                "label": "Request timeout (seconds)",
                "description": "Cloudflare cuts requests off after 100 seconds.",
                "defaultValue": 45,
                "min": 10,
                "max": 90,
                "step": 5
            },
            {
                "type": "toggle",
                "id": "FAST_PATH_ENABLED",
                "messageKey": "FAST_PATH_ENABLED",
                "label": "Instant timers and alarms",
                "description": "Simple commands such as \"Timer 5 Minuten\" or \"Wecker um 6:45\" are handled on the phone without asking the model.",
                "defaultValue": true
            }
        ]
    },
    {
        "type": "section",
        "items": [
            {
                "type": "heading",
                "defaultValue": "Language"
            },
            {
                "type": "select",
                "id": "languageCode",
                "messageKey": "LANGUAGE_CODE",
                "label": "Response language",
                "description": "Controls the language of Buddy's replies. Does not currently translate the rest of the UI. If 'automatic', Buddy will attempt to respond in the same language the question was asked.",
                "defaultValue": "",
                "options": [
                    {"label": "Automatic", "value": ""},
                    {"label": "Afrikaans", "value": "af_ZA"},
                    {"label": "Bahasa Indonesia", "value": "id_ID"},
                    {"label": "Bahasa Melayu", "value": "ms_MY"},
                    {"label": "Čeština", "value": "cs_CZ"},
                    {"label": "Dansk", "value": "da_DK"},
                    {"label": "Deutsch", "value": "de_DE"},
                    {"label": "English", "value": "en_US"},
                    {"label": "Español", "value": "es_ES"},
                    {"label": "Filipino", "value": "fil_PH"},
                    {"label": "Français", "value": "fr_FR"},
                    {"label": "Galego", "value": "gl_ES"},
                    {"label": "Hrvatski", "value": "hr_HR"},
                    {"label": "Íslenska", "value": "is_IS"},
                    {"label": "Italiano", "value": "it_IT"},
                    {"label": "Kiswahili", "value": "sw_TZ"},
                    {"label": "Latviešu", "value": "lv_LV"},
                    {"label": "Lietuvių", "value": "lt_LT"},
                    {"label": "Magyar", "value": "hu_HU"},
                    {"label": "Nederlands", "value": "nl_NL"},
                    {"label": "Norsk", "value": "no_NO"},
                    {"label": "Polski", "value": "pl_PL"},
                    {"label": "Português", "value": "pt_PT"},
                    {"label": "Română", "value": "ro_RO"},
                    {"label": "Русский", "value": "ru_RU"},
                    {"label": "Slovenčina", "value": "sk_SK"},
                    {"label": "Slovenščina", "value": "sl_SI"},
                    {"label": "Suomi", "value": "fi_FI"},
                    {"label": "Svenska", "value": "sv_SE"},
                    {"label": "Türkçe", "value": "tr_TR"},
                    {"label": "IsiZulu", "value": "zu-ZA"}
                ]
            },
            {
                "type": "select",
                "id": "unitPreference",
                "messageKey": "UNIT_PREFERENCE",
                "label": "Unit preference",
                "description": "Your preferred units. If 'both', units will be provided in both systems.",
                "defaultValue": "",
                "options": [
                    {"label": "Automatic", "value": ""},
                    {"label": "Metric", "value": "metric"},
                    {"label": "Imperial", "value": "imperial"},
                    {"label": "UK", "value": "uk"},
                    {"label": "Both", "value": "both"}
                ]
            }
        ]
    },
    {
        "type": "section",
        "items": [
            {
                "type": "heading",
                "defaultValue": "Behaviour"
            },
            {
                "type": "select",
                "messageKey": "ALARM_VIBE_PATTERN",
                "label": "Alarm vibration",
                "defaultValue": "5",
                "options": [
                    {"label": "Reveille", "value": "1"},
                    {"label": "Mario", "value": "2"},
                    {"label": "Nudge Nudge", "value": "3"},
                    {"label": "Jackhammer", "value": "4"},
                    {"label": "Standard", "value": "5"}
                ]
            },
            {
                "type": "select",
                "messageKey": "TIMER_VIBE_PATTERN",
                "label": "Timer vibration",
                "defaultValue": "5",
                "options": [
                    {"label": "Reveille", "value": "1"},
                    {"label": "Mario", "value": "2"},
                    {"label": "Nudge Nudge", "value": "3"},
                    {"label": "Jackhammer", "value": "4"},
                    {"label": "Standard", "value": "5"}
                ]
            },
            {
                "type": "select",
                "messageKey": "QUICK_LAUNCH_BEHAVIOUR",
                "label": "Quick launch behaviour",
                "description": "What to do when Buddy is launched via Quick Launch. If 'start conversation' is selected, Buddy will start listening immediately. If 'stay open' is chosen, Buddy will quit after a minute of inactivity. If 'open home screen' is chosen, Buddy will behave the same as if launched from the app launcher.",
                "defaultValue": "1",
                "options": [
                    {"label": "Start conversation and time out", "value": "1"},
                    {"label": "Start conversation then stay open", "value": "2"},
                    {"label": "Open home screen", "value": "3"}
                ]
            },
            {
                "type": "toggle",
                "messageKey": "CONFIRM_TRANSCRIPTS",
                "defaultValue": false,
                "label": "Confirm prompts before responding",
                "description": "When enabled, after dictating to the watch, you'll always be asked to confirm your input before Buddy takes action. When disabled, Buddy will respond immediately to whatever was recognised."
            }
        ]
    },
    {
        "type": "section",
        "items": [
            {
                "type": "heading",
                "defaultValue": "Permissions"
            },
            {
                "type": "toggle",
                "messageKey": "LOCATION_ENABLED",
                "defaultValue": true,
                "label": "Allow location access",
                "description": "Buddy can use your location for local weather and to understand your local context. Coordinates are sent to your own server with your prompts."
            }
        ]
    },
    {
        "type": "section",
        "items": [
            {
                "type": "heading",
                "defaultValue": "Development"
            },
            {
                "type": "toggle",
                "id": "EMULATOR_REAL_SERVER",
                "messageKey": "EMULATOR_REAL_SERVER",
                "defaultValue": false,
                "label": "Emulator: use the real server",
                "description": "Only affects the Pebble emulator. When off, the emulator replays recorded answers."
            }
        ]
    },
    {
        "type": "submit",
        "defaultValue": "Save"
    }
]
